# Bot Orchestrator Hub — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# =============================================================================
# Required
# =============================================================================

# Telegram Bot API token (from @BotFather)
TELEGRAM_TOKEN=

# Shared secret used to authenticate satellite scripts calling this hub
ORCHESTRATOR_SECRET=change-me-in-production

# Google Apps Script deployment URL for satellite scripts
SATELLITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# =============================================================================
# AI Services
# =============================================================================

# Google AI Studio API Key (Gemini)
GEMINI_API_KEY=

# =============================================================================
# GCP Configuration
# =============================================================================

# Google Cloud Project ID
GCP_PROJECT_ID=

# Cloud Run service name (default: bot-orchestrator)
SERVICE_NAME=bot-orchestrator

# =============================================================================
# Optional
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
LOG_LEVEL=INFO
